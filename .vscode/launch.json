{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",  // Ensures the project is built before debugging
            "program": "${workspaceFolder}/src/CashFlow.Api/bin/Debug/net8.0/CashFlow.Api.dll",  // Correct path to the compiled DLL
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}
